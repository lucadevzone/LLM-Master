# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
DATA_DIR=./data

# ── LLM: Ollama (locale) ──────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434

# ── LLM: OpenAI ───────────────────────────────────────────────────────────────
# Necessaria solo se si usano room con provider=openai
OPENAI_API_KEY=

# ── LLM: valori di default per nuove room ────────────────────────────────────
# Provider usato se la room non ne specifica uno: ollama | openai
DEFAULT_PROVIDER=ollama
# Modello pesante (narrazione, fase creativa)
DEFAULT_CREATIVE_MODEL=llama3.1:8b
# Modello leggero (reasoning, summarization)
DEFAULT_FAST_MODEL=llama3.1:8b

# ── Contesto e summary ────────────────────────────────────────────────────────
MAX_HISTORY_TURNS=20
SUMMARY_THRESHOLD=30
